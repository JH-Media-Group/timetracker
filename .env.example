# Copy to .env.local for development. Every variable here is required at boot
# unless it is marked optional; src/server/env.ts fails loudly rather than
# letting the app start half-configured.

# --- database -----------------------------------------------------------------
DATABASE_URL=postgres://tally:tally_dev_password@localhost:5434/tally
# Used by the test suite. Must be a different database: the tests truncate it.
TEST_DATABASE_URL=postgres://tally:tally_dev_password@localhost:5434/tally_test

# --- redis --------------------------------------------------------------------
# 127.0.0.1, not localhost: the container publishes to the v4 loopback and
# Node resolves localhost to ::1 first, where nothing is listening.
REDIS_URL=redis://127.0.0.1:6382

# --- sessions -----------------------------------------------------------------
# 32+ random bytes, base64. Rotating this signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-32-random-bytes-base64

# --- app ----------------------------------------------------------------------
APP_URL=http://localhost:3200
NODE_ENV=development

# --- proxy --------------------------------------------------------------------
# Whether to believe X-Forwarded-For. Required in production; env.ts refuses to
# boot without it, because both wrong answers are silent.
#
#   1  behind a reverse proxy that sets the header. This is the droplet: Caddy.
#      The last hop is read, not the first, because a proxy appends the address
#      it saw to whatever the caller sent.
#   0  serving directly. Accepts that there is no per-address rate limit, since
#      any address the request offers is one the caller chose.
#
# Locally there is no proxy, so 0 is the honest answer.
TRUST_PROXY=0

# --- optional: Google Workspace SSO -------------------------------------------
# Until these are set, password sign-in is the only route in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=jhmediagroup.com

# --- optional: outbound email (SendGrid) ---------------------------------------
# Unset means invoice sends and reminders are recorded but not delivered, which
# the UI says plainly rather than implying the mail went out.
#
# The username is the literal word "apikey"; the password is the key, which
# starts SG. and is shown once at creation. Grant it Mail Send and nothing else.
#   SMTP_URL=smtps://apikey:SG.xxxxxxxx@smtp.sendgrid.net:465
SMTP_URL=
MAIL_FROM=billing@jhmediagroup.com
# Development only. Production refuses to start if this is enabled.
# MAIL_TO_DISK=1

# --- optional: object storage for receipts, logos, and invoice PDFs -----------
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
