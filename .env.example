# Copy to .env.local for development. Every variable here is required at boot
# unless it is marked optional; src/server/env.ts fails loudly rather than
# letting the app start half-configured.

# --- database -----------------------------------------------------------------
DATABASE_URL=postgres://tally:tally_dev_password@localhost:5434/tally
# Used by the test suite. Must be a different database: the tests truncate it.
TEST_DATABASE_URL=postgres://tally:tally_dev_password@localhost:5434/tally_test

# --- redis --------------------------------------------------------------------
# 127.0.0.1, not localhost: the container publishes to the v4 loopback and
# Node resolves localhost to ::1 first, where nothing is listening.
REDIS_URL=redis://127.0.0.1:6382

# --- sessions -----------------------------------------------------------------
# 32+ random bytes, base64. Rotating this signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-32-random-bytes-base64

# --- app ----------------------------------------------------------------------
APP_URL=http://localhost:3200
NODE_ENV=development

# --- optional: Google Workspace SSO -------------------------------------------
# Until these are set, password sign-in is the only route in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=jhmediagroup.com

# --- optional: outbound email -------------------------------------------------
# Unset means invoice sends and reminders are recorded but not delivered.
SMTP_URL=
MAIL_FROM=billing@jhmediagroup.com

# --- optional: object storage for receipts, logos, and invoice PDFs -----------
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
