{
  "name": "tally",
  "version": "0.1.0",
  "private": true,
  "description": "JH Media Group time tracking, profitability, and invoicing",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:palette": "node scripts/validate-palette.mjs \"#2a78d6,#eb6834,#1baf7a,#eda100,#e87ba4,#008300,#4a3aa7,#e34948\" --mode light --surface \"#FFFFFF\" && node scripts/validate-palette.mjs \"#3987e5,#d95926,#199e70,#c98500,#d55181,#008300,#9085e9,#e66767\" --mode dark --surface \"#111113\"",
    "db:up": "docker compose -f docker/compose.dev.yml up -d",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:migrate:test": "tsx src/server/db/migrate.ts --test",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:reset": "tsx src/server/db/reset.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:migrate:test && pnpm db:seed",
    "authz:sweep": "tsx scripts/authz-sweep.mts",
    "authz:scope": "tsx scripts/scope-probe.mts",
    "db:cleanup-probe": "tsx scripts/cleanup-probe.mts",
    "db:invariants": "tsx scripts/invariants.mts",
    "jobs:recurring": "tsx scripts/recurring.mts",
    "jobs:mail": "tsx scripts/mail.mts",
    "harvest:import": "tsx scripts/harvest-import.mts",
    "harvest:reconcile": "tsx scripts/harvest-reconcile.mts",
    "sweep": "tsx scripts/sweep.mts",
    "invite:link": "tsx scripts/invite-link.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "ag-grid-community": "^34.0.0",
    "ag-grid-react": "^34.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0"
    }
  }
}
